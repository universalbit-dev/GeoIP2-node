# ==========================================
# GeoIP2-node Multi-RBL Scanner Configuration
# ==========================================

# --- 1. Threat Intelligence API Keys (Optional but Recommended) ---
# Get a free key at: https://maltiverse.com/
MALTIVERSE_API_KEY=""

# Get a free key at: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=""

# --- 2. Multi-RBL DNS Engine Settings ---
# If your ISP blocks Port 53 or public resolvers drop your queries (causing timeouts), 
# specify your local ISP's DNS IP here. If left blank, the script defaults to 8.8.8.8.
SPAMHAUS_DNS_SERVER="8.8.8.8"

# --- 3. Geographical Data Provider ---
# Options: "ip-api" (Free, no key needed) OR "ipinfo" (Requires token)
GEOIP_PROVIDER="ip-api"

# Only required if GEOIP_PROVIDER is set to "ipinfo"
GEOIP_PROVIDER_TOKEN=""

# --- 4. Caching & Interval Timers ---
# How long (in seconds) to keep results saved on your disk before querying APIs again. 
# 86400 = 24 hours. This protects you from burning through API rate limits.
GEOIP_CACHE_TTL_SECS=86400

# How often (in milliseconds) the background daemon checks your IP when running continuously.
# 3600000 = 1 hour.
SCAN_INTERVAL_MS=3600000

# Maltiverse hourly rate limit protection (Default free tier is usually safe at 20)
MALTIVERSE_QUOTA_PER_HOUR=20
MALTIVERSE_INTERVAL_MS=3600000
