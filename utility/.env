# Maltiverse API key (required to enable Maltiverse checks)
MALTIVERSE_API_KEY=

# GeoIP provider settings
GEOIP_PROVIDER=ip-api
GEOIP_PROVIDER_TOKEN=

# Cache TTL (seconds) for GeoIP & Maltiverse results (default: 86400 = 24h)
GEOIP_CACHE_TTL_SECS=86400

# Maltiverse quota + interval
MALTIVERSE_QUOTA_PER_HOUR=20
MALTIVERSE_INTERVAL_MS=3600000

# Scanner interval (ms): how often to check (default: 3600000 = 1 hour)
SCAN_INTERVAL_MS=3600000
